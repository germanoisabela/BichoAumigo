# Modelo das variáveis de ambiente do projeto.
#
# Como usar: este projeto já possui uma configuração pública padrão no código.
# Você pode copiar este arquivo para ".env" caso queira sobrescrever essa configuração.
# O arquivo ".env" NÃO vai para o GitHub (está no .gitignore); este ".env.example" serve
# como modelo e também contém apenas a URL e a chave publicável do projeto.
#
# ATENÇÃO: no Vite, só variáveis que começam com VITE_ chegam ao navegador, e tudo o que chega
# ao navegador fica PÚBLICO. Por isso, chaves secretas (senhas, "service role", Client Secret
# do Google...) nunca devem ficar aqui: elas pertencem ao backend.
#
VITE_SUPABASE_URL=https://zfrhyafzmknbjpnqukcm.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_gkU1vxMtKcK3biPEnpIM2g_yHV7K9Fd
